# Set these in Render > annahflix-api > Environment; do not commit real values.
NODE_ENV=production
# Copy BOTH URLs from neon deploy / .env.local; preserve SSL parameters.
# A single Node instance can use a small connection pool. Do not use localhost.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=15
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require&connect_timeout=15
# The Blueprint generates JWT_SECRET automatically. Keep it stable thereafter.
JWT_SECRET=replace-with-at-least-32-random-characters
# Mobile-only: leave both empty. For a website, set its exact HTTPS origin.
CORS_ORIGIN=
PUBLIC_WEB_URL=
TRUST_PROXY_HOPS=1
ALLOW_HTTP_STREAMS=false
TMDB_ACCESS_TOKEN=your-existing-tmdb-read-access-token
LIVEKIT_URL=wss://your-existing-project.livekit.cloud
LIVEKIT_API_KEY=your-existing-livekit-api-key
LIVEKIT_API_SECRET=your-existing-livekit-api-secret

# Optional: copy the existing private R2 configuration to preserve cloud uploads.
# Leave out these keys if not using R2; do not enter placeholder credentials.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# R2_MAX_MOVIE_BYTES=1073741824
# R2_USER_QUOTA_BYTES=8589934592

# Optional one-time administrator creation. Remove after registration.
# ADMIN_BOOTSTRAP_EMAIL=your-own-email-address
