# Render > annahflix-web > Environment. Public URLs only; never put keys here.
EXPO_PUBLIC_API_URL=https://YOUR-API-SERVICE.onrender.com
# Build script defaults this to API URL, which Socket.IO upgrades to WSS.
# EXPO_PUBLIC_SOCKET_URL=https://YOUR-API-SERVICE.onrender.com
# Render supplies RENDER_EXTERNAL_URL, used as the default website origin.
# Set explicitly if sharing a custom domain instead.
# EXPO_PUBLIC_WEB_URL=https://YOUR-WEB-SERVICE.onrender.com
