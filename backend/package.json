{
  "name": "@togetherflix/backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node scripts/prisma.cjs generate",
    "prisma:push": "node scripts/prisma.cjs db push",
    "prisma:deploy": "node scripts/prisma.cjs migrate deploy",
    "prisma:studio": "node scripts/prisma.cjs studio",
    "admin:grant": "tsx src/scripts/grant-admin.ts",
    "test": "tsx tests/runTests.ts && tsx tests/vidcore.test.ts && tsx tests/watchPartyFlow.test.ts && tsx --test tests/callConnectionLifecycle.test.ts tests/catalogCaching.test.ts tests/productionEnvironment.test.ts tests/environment.test.ts",
    "test:drama": "node tests/runDramaTests.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/client": "^5.14.0",
    "@togetherflix/shared": "file:../shared",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.1.2",
    "multer": "^2.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
