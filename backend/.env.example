DATABASE_URL=postgresql://togetherflix:change-me@localhost:5432/togetherflix?schema=public
# Optional locally (the loader reuses a non-pooled URL); required with Neon pooling.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# Render production: set NODE_ENV=production, an exact HTTPS website origin,
# and TRUST_PROXY_HOPS=1. Leave trust at 0 when running without a proxy.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-long-random-secret
# LiveKit handles WebRTC signaling, ICE, STUN/TURN, and SFU media forwarding.
# Use a wss:// URL in deployed builds. These credentials are backend-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# TMDB is metadata-only. Prefer the read access token; API key is supported as
# a fallback. Neither value is included in the mobile bundle.
TMDB_ACCESS_TOKEN=your-tmdb-api-read-access-token
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_CACHE_TTL_SECONDS=900

# Licensed/public-domain source discovery cache.
INTERNET_ARCHIVE_CACHE_TTL_SECONDS=3600

# Private Cloudflare R2 bucket. These values are backend-only.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=togetherflix-movies
R2_MAX_MOVIE_BYTES=21474836480
R2_USER_QUOTA_BYTES=107374182400

# Optional one-time bootstrap: a newly registering matching email is ADMIN.
# Remove this after creating the first administrator.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Keep false in production. HTTPS is required for remote DASH/HLS/MP4 sources.
ALLOW_HTTP_STREAMS=false

# Optional deployed web app origin for browser invite redirects.
PUBLIC_WEB_URL=http://localhost:8081
