datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum RoomStatus {
  WAITING
  COMPATIBILITY_CHECK
  WATCHING
  ENDED
}

enum PartnerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MovieStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MovieSourceType {
  UPLOAD
  STREAM
  MANIFEST
}

enum StreamingFormat {
  AUTO
  DASH
  HLS
  MP4
  WEBM
}

enum PlaybackMode {
  IFRAME
  DIRECT
  SCREEN_SHARE
  MANUAL
}

enum UserRole {
  ADMIN
  USER
}

enum ViewerReadiness {
  WAITING
  LOADING
  BUFFERING
  READY
  ERROR
  DISCONNECTED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  activeSessionId String?
  passwordHash    String
  displayName     String
  role            UserRole         @default(USER)
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  partnerId       String?          @unique
  partner         User?            @relation("CoupleRelation", fields: [partnerId], references: [id])
  partnerOf       User?            @relation("CoupleRelation")

  sentInvites     PartnerInvite[]  @relation("SentInvites")
  receivedInvites PartnerInvite[]  @relation("ReceivedInvites")

  hostedRooms     Room[]           @relation("HostedRooms")
  guestRooms      Room[]           @relation("GuestRooms")
  movieHistories  MovieHistory[]
  movies          Movie[]
  watchlist       UserWatchlist[]
  watchProgress   WatchProgress[]

  @@index([email])
}

model UserWatchlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  title       String
  posterUrl   String?
  backdropUrl String?
  overview    String?
  releaseYear Int?
  rating      Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, tmdbId])
  @@index([userId, createdAt])
}

model WatchProgress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId            Int
  title             String
  posterUrl         String?
  backdropUrl       String?
  positionSeconds   Float
  durationSeconds   Float
  completionPercent Float
  lastWatchedAt     DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@unique([userId, tmdbId])
  @@index([userId, lastWatchedAt])
}

model PartnerInvite {
  id          String              @id @default(uuid())
  senderId    String
  sender      User                @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  inviteEmail String
  receiverId  String?
  receiver    User?               @relation("ReceivedInvites", fields: [receiverId], references: [id], onDelete: SetNull)
  code        String              @unique
  status      PartnerInviteStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  expiresAt   DateTime

  @@index([code])
  @@index([inviteEmail])
}

model Room {
  id                  String          @id @default(uuid())
  code                String          @unique
  status              RoomStatus      @default(WAITING)
  hostId              String
  host                User            @relation("HostedRooms", fields: [hostId], references: [id])
  guestId             String?
  guest               User?           @relation("GuestRooms", fields: [guestId], references: [id])
  isHostOnlyControl   Boolean         @default(false)
  catalogSelection    Json?
  currentMovieTitle   String?
  playbackPosition    Float           @default(0)
  playbackIsPlaying   Boolean         @default(false)
  playbackUpdatedAt   DateTime?
  playbackVersion     Int             @default(0)
  playbackMode        PlaybackMode    @default(MANUAL)
  screenSharingUserId String?
  selectedMovieId     String?
  selectedMovie       Movie?          @relation("SelectedRoomMovie", fields: [selectedMovieId], references: [id])
  createdAt           DateTime        @default(now())
  closedAt            DateTime?

  filesMetadata       RoomMovieMeta[]
  viewerStates        RoomViewerState[]
  chatMessages        ChatMessage[]
  history             MovieHistory?

  @@index([code])
  @@index([selectedMovieId])
}

model Movie {
  id               String      @id @default(uuid())
  ownerId          String
  owner            User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  storageKey       String      @unique
  mimeType         String
  fileSize         BigInt
  status           MovieStatus @default(UPLOADING)
  sourceType       MovieSourceType @default(UPLOAD)
  streamingUrl     String?
  streamingFormat  StreamingFormat?
  manifestBaseUrl  String?
  description      String?
  durationSeconds  Float?
  posterKey        String?
  posterUrl        String?
  multipartUploadId String?
  tmdbId            Int?
  providerId        String?
  providerSourceId  String?
  licenseUrl        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  parts            MovieUploadPart[]
  selectedByRooms  Room[]      @relation("SelectedRoomMovie")

  @@index([ownerId, status])
  @@index([sourceType, status])
  @@index([tmdbId])
  @@index([providerId, providerSourceId])
}

model MovieUploadPart {
  id         String @id @default(uuid())
  movieId    String
  movie      Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  partNumber Int
  eTag       String

  @@unique([movieId, partNumber])
}

model RoomMovieMeta {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  fileName        String
  durationSeconds Float
  fileSizeBytes   BigInt?
  isReady         Boolean  @default(false)
  mediaPath       String?
  mimeType        String?
  updatedAt       DateTime @updatedAt

  @@unique([roomId, userId])
}

// This is deliberately separate from the legacy local-file metadata.  A cloud
// movie is shared by id, while readiness is a property of each device/player.
model RoomViewerState {
  id              String          @id @default(uuid())
  roomId          String
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  selectedMovieId String
  state           ViewerReadiness @default(WAITING)
  updatedAt       DateTime        @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, selectedMovieId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  message   String
  createdAt DateTime @default(now())

  @@index([roomId])
}

model MovieHistory {
  id              String   @id @default(uuid())
  roomId          String   @unique
  room            Room     @relation(fields: [roomId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  partnerName     String
  movieTitle      String
  durationMinutes Int
  watchedAt       DateTime @default(now())
  notes           String?

  @@index([userId])
}
