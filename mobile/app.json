{
  "expo": {
    "name": "AnnahFlix",
    "slug": "togetherflix",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#080808",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AnnahFlix needs camera access so you can video call your partner while watching movies.",
        "NSMicrophoneUsageDescription": "AnnahFlix needs microphone access so you can talk to your partner while watching movies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080808"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WAKE_LOCK"
      ],
      "package": "com.togetherflix.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "scheme": "togetherflix",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9014f563-67ca-46b3-8073-4a9193fe9f62"
      }
    },
    "owner": "devareajustins-team",
    "description": "A cinematic place for your movies, with a separate space for movie nights together.",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9014f563-67ca-46b3-8073-4a9193fe9f62",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
